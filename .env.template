# Environment Variables Template
# Copy this file to .env and fill in your values
# The .env file is gitignored and will not be committed

# Projector HTTP Web Interface Credentials
# Note: Default password is "Projector" (capital P) but MUST be changed on first login
PROJECTOR_PASSWORD=Projector

# Optional: Override projector IP (if not using config.yaml)
# PROJECTOR_IP=192.168.1.100

# Optional: Override HTTP username (default: root)
# PROJECTOR_USERNAME=root

# Optional: Override HTTP port (default: 80)
# PROJECTOR_PORT=80

# Optional: Override proxy port (default: 8888)
# PROXY_PORT=8888

# Raspberry Pi SSH Credentials
# Used by setup-ssh-key.sh and other deployment scripts
RASPBERRY_PI_IP=192.168.50.110
RASPBERRY_PI_USER=admin
RASPBERRY_PI_PASSWORD=admin
